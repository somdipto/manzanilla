# Load in shell / service manager. Server secrets never belong in the Android APK
# except the Fish pilot key described below, which is compiled in from a build secret.
ORANGE_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
ORANGE_DB=data/orange.db
# Gemini Live backend: raw BidiGenerateContent, PCM16 mono 24 kHz.
# Model documented at https://ai.google.dev/gemini-api/docs/models/gemini-2.5-flash-native-audio-preview-12-2025
# Verify entitlement/retention/model availability before real guests; no OpenAI fallback.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Fish managed interpreter: backend-only credentials in ordinary deployments.
# Debug and normal release builds never embed FISH_API_KEY. An explicitly authorized
# release with ORANGE_KEYED_PILOT=true reads FISH_API_KEY from the environment only.
# That pilot APK exposes the account credential to extraction; never use it for production.
# Full conversation-second reservations, not dollar-denominated spending limits.
FISH_HOTEL_DAILY_SECONDS=1800
FISH_ACCOUNT_DAILY_SECONDS=3600
FISH_API_KEY=
FISH_VOICE_ID=
# Hotel-owned read-only gateway adapter. No PMS vendor is yet identified.
# Exact hotel ID "hotel-1" encoded as uppercase UTF-8 hex; no legacy alias fallback.
PMS_686F74656C2D31_URL=https://your-gateway.example.com
PMS_686F74656C2D31_TOKEN=
# Edge service (run on the hotel PC, separate device-scoped credential)
ORANGE_EDGE_URL=wss://orange.example.com/ws/edge
ORANGE_EDGE_TOKEN=
ORANGE_RESERVATION_FILE=/opt/orange/reservations.json
# Android release signing only, in CI secrets; absent means UNSIGNED release
ORANGE_KEYSTORE=
ORANGE_STORE_PASSWORD=
ORANGE_KEY_ALIAS=
ORANGE_KEY_PASSWORD=
