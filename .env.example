# Load in shell / service manager. Never put these into the Android APK.
ORANGE_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
ORANGE_DB=data/orange.db
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Hotel-owned read-only gateway adapter. No PMS vendor is yet identified.
PMS_HOTEL_1_URL=https://your-gateway.example.com
PMS_HOTEL_1_TOKEN=
# Edge service (run on the hotel PC, separate device-scoped credential)
ORANGE_EDGE_URL=wss://orange.example.com/ws/edge
ORANGE_EDGE_TOKEN=
ORANGE_RESERVATION_FILE=/opt/orange/reservations.json
# Android release signing only, in CI secrets; absent means UNSIGNED release
ORANGE_KEYSTORE=
ORANGE_STORE_PASSWORD=
ORANGE_KEY_ALIAS=
ORANGE_KEY_PASSWORD=
