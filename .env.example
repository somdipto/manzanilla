# Load in the backend service manager; hotel/device/admin credentials never belong in an APK.
# User-owned provider credentials stay server-side or in encrypted personal-app settings.
ORANGE_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
ORANGE_DB=data/orange.db
# Explicit translation pipeline, approved hotel-fact selection and unapproved staff drafts.
GEMINI_API_KEY=
# Internal managed-interpreter credentials remain server-side.
# Duration reservations below are not free-only eligibility or monetary limits.
FISH_HOTEL_DAILY_SECONDS=1800
FISH_ACCOUNT_DAILY_SECONDS=3600
FISH_API_KEY=
FISH_VOICE_ID=
# All NEW sessions use Fish ASR -> Gemini translation -> Fish TTS, with LiveKit transport.
# Exactly one configured worker must own this room namespace.
LIVEKIT_WORKER_ENABLED=0
# Evaluation only: must equal 1 to admit a NEW managed LiveKit reservation.
# Leave disabled normally. Recorded-request recovery/end/cleanup remain available.
ALLOW_UNQUALIFIED_LIVEKIT=0
# Evaluation has exactly one backend/SQLite owner and one worker per room namespace.
# Reject multi-owner or strict immediate token-revocation production requirements.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker Gemini endpoint/model: see infra/livekit.compose.yaml; no substitute model.
# Every APK variant is key-free. Personal users enter Fish + Gemini keys after installation.
# FISH_VOICE_ID is a non-secret voice identifier, not an access credential.
# Hotel-owned read-only gateway adapter. No PMS vendor is yet identified.
# Exact hotel ID "hotel-1" encoded as uppercase UTF-8 hex; no legacy alias fallback.
PMS_686F74656C2D31_URL=https://your-gateway.example.com
PMS_686F74656C2D31_TOKEN=
# Edge service (run on the hotel PC, separate device-scoped credential)
ORANGE_EDGE_URL=wss://orange.example.com/ws/edge
ORANGE_EDGE_TOKEN=
ORANGE_RESERVATION_FILE=/opt/orange/reservations.json
# Android release signing only, in CI secrets; absent means UNSIGNED release
ORANGE_KEYSTORE=
ORANGE_STORE_PASSWORD=
ORANGE_KEY_ALIAS=
ORANGE_KEY_PASSWORD=
