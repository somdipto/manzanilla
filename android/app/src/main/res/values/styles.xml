<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Manzanilla" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#F5C842</item>
        <item name="android:navigationBarColor">#041238</item>
        <item name="android:statusBarColor">#041238</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">#041238</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_manzanilla</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <style name="Theme.Manzanilla.Overlay" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
